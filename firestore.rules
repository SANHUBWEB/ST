rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function role() {
      return request.auth != null && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        ? get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function isStaff() { return role() in ['admin', 'agent']; }

    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['customer','contact','productId','productName','amount','payment','status','agent','agentName','date'])
        && request.resource.data.customer is string && request.resource.data.customer.size() >= 2 && request.resource.data.customer.size() <= 60
        && request.resource.data.contact.matches('^[6-9][0-9]{9}$')
        && request.resource.data.amount is number
        && request.resource.data.status == 'Pending'
        && request.resource.data.payment == 'Unpaid'
        && request.resource.data.agent == ''
        && request.resource.data.date == request.time;
      allow read: if isAdmin() || (isStaff() && resource.data.agent == request.auth.uid);
      allow update: if isAdmin() ||
        (isStaff() && resource.data.agent == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isAdmin();
    }
  }
}
